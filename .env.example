# Copia questo file come ".env" e inserisci i valori reali.
# Non committare .env (contiene segreti).

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Percorso file SQLite (in Docker compose è preimpostato su /data/cf_googlebot.db)
# SQLITE_PATH=./data/cf_googlebot.db

# Server HTTP (LAN)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=418

# Ingest giornaliero (orologio UTC)
# INGEST_HOUR_UTC=3
# INGEST_MINUTE_UTC=0

# Pattern userAgent_like GraphQL — baseline «tutto Googlebot» (per differenza: googlebot = broad − image − other)
# USER_AGENT_LIKE=%Googlebot%
# Filtri per classi UA (v1.1 DATA_MODEL); usati in ingest insieme a USER_AGENT_LIKE
# UA_GOOGLEBOT_IMAGE=%Googlebot-Image%
# UA_GOOGLEBOT_VIDEO=%Googlebot-Video%
# UA_GOOGLEBOT_NEWS=%Googlebot-News%

# Esegui un ingest all'avvio (utile in dev; in produzione spesso false)
# INGEST_ON_STARTUP=false

# Limite gruppi per chunk GraphQL (max tipico API 10000)
# GRAPHQL_LIMIT_PER_CHUNK=10000
# Pausa secondi tra chunk
# GRAPHQL_PAUSE_SEC=0.35

# Giorni UTC per il pulsante «Backfill 7+1» (default 8 = da oggi-8 a ieri)
# BACKFILL_LOOKBACK_DAYS=8
